  "conductor_choice": {
    "source": "doe_conductors_2023",
    "facts": [
      {
        "statement": "Aluminium has roughly 60% of copper's electrical conductivity by equal cross-sectional area.",
        "implication": "An equivalent conductor generally needs more aluminium cross-section."
      },
      {
        "statement": "Aluminium can carry roughly twice as much current as copper by equal weight.",
        "implication": "Low weight favours aluminium in overhead spans."
      },
      {
        "statement": "Steel-reinforced aluminium conductor has been used since the early 1900s and is the world's most widely used overhead conductor type.",
        "implication": "Substitution is an old engineering architecture, not a recent emergency response."
      }
    ],
    "boundary": "Material choice depends on conductivity, strength, weight, diameter, connections, route, losses and lifetime cost; there is no universal copper-to-aluminium ratio."
  },
